---
// 記事ページ。既存の記事（public/posts/*.html）と同じ HTML 構造で表示する
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  draft?: boolean;
}

const { title, description, date, draft = false } = Astro.props;
---
<BaseLayout title={`${title} | yonabechan`} description={description} active="posts" noindex={draft}>
  <article>
    <header class="article-header">
      <p class="article-date">{formatDate(date)}{draft && '（下書き：公開されません）'}</p>
      <h1>{title}</h1>
    </header>

    <div class="article-body">
      <slot />
    </div>
  </article>

  <p><a href="/posts/index.html" class="back-link">← Back to Posts</a></p>
</BaseLayout>
