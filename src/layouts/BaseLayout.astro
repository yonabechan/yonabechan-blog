---
// 全ページ共通のヘッダー・フッター（既存の HTML と同じ構造・CSS）
interface Props {
  title: string;
  description: string;
  active?: 'home' | 'posts' | 'profile';
  noindex?: boolean;
}

const { title, description, active, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/index.html" class="site-title">yonabechan</a>
      <nav class="site-nav">
        <a href="/index.html" class:list={{ active: active === 'home' }}>Home</a>
        <a href="/posts/index.html" class:list={{ active: active === 'posts' }}>Posts</a>
        <a href="/profile.html" class:list={{ active: active === 'profile' }}>Profile</a>
      </nav>
    </div>
    <div class="header-scene" aria-hidden="true"></div>
  </header>

  <main class="container">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; 2026 yonabechan</p>
    </div>
  </footer>
</body>
</html>
